# Copy this file to .env.local and replace placeholder values. Do not commit .env.local.

# MongoDB Atlas connection string used by Mongoose and the Auth.js adapter.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/flowlary

# Secret used to sign Auth.js sessions; generate a long random value.
NEXTAUTH_SECRET=replace_with_a_random_string
# Base URL used by Auth.js for local callback and redirect URLs.
NEXTAUTH_URL=http://localhost:3000
# Optional Auth.js v5 secret alias; use this instead of NEXTAUTH_SECRET, not both.
AUTH_SECRET=replace_with_a_random_string
# Optional Google OAuth client ID for Google sign-in.
AUTH_GOOGLE_ID=your_google_oauth_client_id
# Optional Google OAuth client secret for Google sign-in.
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret

# API key used by the server-side Groq AI client.
GROQ_API_KEY=your_groq_api_key_here

# Node environment used to select development connection caching behavior.
NODE_ENV=development
